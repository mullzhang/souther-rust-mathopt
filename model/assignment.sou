module example.assignment

data WorkerId = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]{0,63}", value)
data JobId = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]{0,63}", value)
data Minutes = Int
    invariant value >= 0 && value <= 1440
data Duration = Int
    invariant value > 0 && value <= 1440
data LoadMinutes = Int
    invariant value >= 0 && value <= 46080
data Cost = Int
    invariant value >= 0 && value <= 1000000
data MinuteRate = Int
    invariant value > 0 && value <= 10000
data TotalCost = Int
    invariant value >= 0 && value <= 1000000000

data Worker = { id: WorkerId, regularMinutes: Minutes, overtimeLimit: Minutes, overtimeRate: MinuteRate }
data Job = { id: JobId }
// A listed pair means the worker is qualified for this job.
data Offer = { workerId: WorkerId, jobId: JobId, minutes: Duration, cost: Cost }
data AssignmentProblem = { workers: List<Worker>, jobs: List<Job>, offers: List<Offer> }
    invariant workerLimit = List.length(workers) <= 16
    invariant jobLimit = List.length(jobs) <= 32
    invariant offerLimit = List.length(offers) <= 512
    invariant uniqueWorkers = List.all(w -> List.length(List.filter(v -> v.id == w.id, workers)) == 1, workers)
    invariant uniqueJobs = List.all(j -> List.length(List.filter(v -> v.id == j.id, jobs)) == 1, jobs)
    invariant uniqueOffers = List.all(o -> List.length(List.filter(p -> p.workerId == o.workerId && p.jobId == o.jobId, offers)) == 1, offers)
    invariant knownWorkers = List.all(o -> List.any(w -> w.id == o.workerId, workers), offers)
    invariant knownJobs = List.all(o -> List.any(j -> j.id == o.jobId, jobs), offers)

// A candidate may violate the current problem. assess explains that refusal.
data Assignment = { workerId: WorkerId, jobId: JobId }
data WorkerLoad = { workerId: WorkerId, minutes: LoadMinutes, overtime: LoadMinutes }
data CandidatePlan = { assignments: List<Assignment>, loads: List<WorkerLoad>, totalCost: TotalCost }
    invariant assignmentLimit = List.length(assignments) <= 32
    invariant loadLimit = List.length(loads) <= 16

data Optimal = { plan: CandidatePlan }
data Feasible = { plan: CandidatePlan, termination: String }
data Infeasible
data NoSolution = { termination: String }
data SearchOutcome = Optimal | Feasible | Infeasible | NoSolution

data Ready
data RequiresApproval = { overtimeMinutes: LoadMinutes }
data Rejected = { reason: String }
data Unavailable
data Assessment = Ready | RequiresApproval | Rejected | Unavailable
data PlanningResult = { search: SearchOutcome, assessment: Assessment }
data Confirmed = { plan: CandidatePlan }
data Confirmation = Confirmed | RequiresApproval | Rejected

behavior solve : (problem: AssignmentProblem) -> SearchOutcome
    constructs Assignment, WorkerLoad, CandidatePlan, Optimal, Feasible, NoSolution

behavior planAssignments : (problem: AssignmentProblem) -> PlanningResult
    depends on solve
let planAssignments (problem, solve) = {
    let result = solve(problem)
    let assessment = match result with
        | Optimal { plan } -> assess(problem, plan)
        | Feasible { plan, termination } -> assess(problem, plan)
        | Infeasible -> Unavailable
        | NoSolution { termination } -> Unavailable
    PlanningResult { search = result, assessment = assessment }
}

behavior assess : (problem: AssignmentProblem, plan: CandidatePlan) -> Assessment
let assess (problem, plan) = {
    guard List.all(a -> List.length(List.filter(b -> b.jobId == a.jobId, plan.assignments)) == 1, plan.assignments)
        && List.length(plan.assignments) == List.length(problem.jobs)
        && List.all(j -> List.any(a -> a.jobId == j.id, plan.assignments), problem.jobs)
        else Rejected { reason = "job_coverage" }
    guard List.all(a -> List.any(o -> o.workerId == a.workerId && o.jobId == a.jobId, problem.offers), plan.assignments)
        else Rejected { reason = "qualification" }
    guard List.all(l -> List.length(List.filter(m -> m.workerId == l.workerId, plan.loads)) == 1, plan.loads)
        && List.length(plan.loads) == List.length(problem.workers)
        && List.all(w -> List.any(l -> l.workerId == w.id, plan.loads), problem.workers)
        else Rejected { reason = "worker_coverage" }
    guard List.all(w -> List.all(l -> l.workerId /= w.id ||
        (l.minutes.value == minutesFor(problem, plan, w.id)
         && l.overtime.value == overtimeFor(problem, plan, w)
         && l.overtime.value <= w.overtimeLimit.value), plan.loads), problem.workers)
        else Rejected { reason = "workload" }
    guard plan.totalCost.value == costFor(problem, plan)
        else Rejected { reason = "total_cost" }
    let overtime = List.sum(List.map(l -> l.overtime.value, plan.loads))
    if overtime > 0 then RequiresApproval { overtimeMinutes = LoadMinutes(overtime) }
    else Ready
}

// Approval is an explicit caller decision, not a solver status.
behavior confirm : (problem: AssignmentProblem, plan: CandidatePlan, overtimeApproved: Bool) -> Confirmation
let confirm (problem, plan, overtimeApproved) =
    match assess(problem, plan) with
        | Ready -> Confirmed { plan = plan }
        | RequiresApproval { overtimeMinutes } ->
            if overtimeApproved then Confirmed { plan = plan }
            else RequiresApproval { overtimeMinutes = overtimeMinutes }
        | Rejected { reason } -> Rejected { reason = reason }
        | Unavailable -> Rejected { reason = "unavailable" }

let selected (plan: CandidatePlan, offer: Offer) =
    List.any(a -> a.workerId == offer.workerId && a.jobId == offer.jobId, plan.assignments)
let minutesFor (problem: AssignmentProblem, plan: CandidatePlan, workerId: WorkerId) =
    List.sum(List.map(o -> if o.workerId == workerId && selected(plan, o) then o.minutes.value else 0, problem.offers))
let overtimeFor (problem: AssignmentProblem, plan: CandidatePlan, worker: Worker) = {
    let extra = minutesFor(problem, plan, worker.id) - worker.regularMinutes.value
    if extra > 0 then extra else 0
}
let costFor (problem: AssignmentProblem, plan: CandidatePlan) =
    List.sum(List.map(o -> if selected(plan, o) then o.cost.value else 0, problem.offers))
    + List.sum(List.map(w -> overtimeFor(problem, plan, w) * w.overtimeRate.value, problem.workers))

example assess
    | "An empty valid plan is ready" :
        (AssignmentProblem { workers = [], jobs = [], offers = [] },
         CandidatePlan { assignments = [], loads = [], totalCost = TotalCost(0) }) -> Ready
    | "A candidate cannot invent a cost" :
        (AssignmentProblem { workers = [], jobs = [], offers = [] },
         CandidatePlan { assignments = [], loads = [], totalCost = TotalCost(1) })
        -> Rejected { reason = "total_cost" }

example confirm
    | "Approval cannot override a rejected plan" :
        (AssignmentProblem { workers = [], jobs = [], offers = [] },
         CandidatePlan { assignments = [], loads = [], totalCost = TotalCost(1) }, true)
        -> Rejected { reason = "total_cost" }
