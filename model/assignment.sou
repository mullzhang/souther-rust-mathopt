module example.assignment

// valid: value representation, identifiers and unambiguous references.
// The bounded input envelope keeps integer arithmetic exact in both runtimes.
data WorkerId = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]{0,63}", value)
data JobId = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]{0,63}", value)
data Minutes = Int
    invariant value >= 0 && value <= 1440
data Duration = Int
    invariant value > 0 && value <= 1440
data LoadMinutes = Int
    invariant value >= 0 && value <= 46080
data Cost = Int
    invariant value >= 0 && value <= 1000000
data MinuteRate = Int
    invariant value > 0 && value <= 10000
data TotalCost = Int
    invariant value >= 0 && value <= 8000000000

data Worker = { id: WorkerId, regularMinutes: Minutes, overtimeLimit: Minutes, overtimeRate: MinuteRate, overtimeTarget: Minutes, overtimePenalty: MinuteRate }
data Job = { id: JobId }
// Prices and durations exist even when qualified is false.
data Offer = { workerId: WorkerId, jobId: JobId, minutes: Duration, cost: Cost, qualified: Bool }
data AssignmentProblem = { workers: List<Worker>, jobs: List<Job>, offers: List<Offer> }
    invariant workerLimit = List.length(workers) <= 16
    invariant jobLimit = List.length(jobs) <= 32
    invariant offerLimit = List.length(offers) <= 512
    invariant uniqueWorkers = List.all(w -> List.length(List.filter(v -> v.id == w.id, workers)) == 1, workers)
    invariant uniqueJobs = List.all(j -> List.length(List.filter(v -> v.id == j.id, jobs)) == 1, jobs)
    invariant uniqueOffers = List.all(o -> List.length(List.filter(p -> p.workerId == o.workerId && p.jobId == o.jobId, offers)) == 1, offers)
    invariant knownWorkers = List.all(o -> List.any(w -> w.id == o.workerId, workers), offers)
    invariant knownJobs = List.all(o -> List.any(j -> j.id == o.jobId, jobs), offers)

// A candidate is a set of selected pairs. Missing or multiply assigned jobs are hard violations.
// Derived loads and costs are evaluation outputs, never caller-supplied assertions.
data Assignment = { workerId: WorkerId, jobId: JobId }
data CandidatePlan = { assignments: List<Assignment> }
    invariant assignmentLimit = List.length(assignments) <= 512
    invariant uniquePairs = List.all(a -> List.length(List.filter(b -> b.workerId == a.workerId && b.jobId == a.jobId, assignments)) == 1, assignments)
// Contextual valid constraints are checked when this evaluation input is constructed.
data EvaluationInput = { problem: AssignmentProblem, plan: CandidatePlan }
    invariant definedPairs = List.all(a -> List.any(o -> o.workerId == a.workerId && o.jobId == a.jobId, problem.offers), plan.assignments)

data WorkerLoad = { workerId: WorkerId, minutes: LoadMinutes, overtime: LoadMinutes }
data HardViolation = { rule: String, subject: String, actual: Int, limit: Int, amount: Int }
data SoftPenalty = { rule: String, subject: String, actual: Int, limit: Int, amount: Int, weight: Int, penalty: Int }
data Evaluation = { feasible: Bool, hardViolations: List<HardViolation>, softPenalties: List<SoftPenalty>, loads: List<WorkerLoad>, totalCost: TotalCost, softPenalty: Int, objectiveValue: Int }

data Ready
data RequiresApproval = { overtimeMinutes: LoadMinutes }
data Rejected
data Confirmed
data Decision = Ready | RequiresApproval | Rejected | Confirmed
data PlanReview = { plan: CandidatePlan, evaluation: Evaluation, decision: Decision }

// These names describe solver termination, not the evaluator's feasibility judgment.
data OptimalCandidate = { plan: CandidatePlan }
data StoppedWithCandidate = { plan: CandidatePlan, termination: String }
data Infeasible
data NoCandidate = { termination: String }
data SearchOutcome = OptimalCandidate | StoppedWithCandidate | Infeasible | NoCandidate
behavior solve : (problem: AssignmentProblem) -> SearchOutcome
    constructs Assignment, CandidatePlan, OptimalCandidate, StoppedWithCandidate, NoCandidate

let selected (plan: CandidatePlan, offer: Offer) =
    List.any(a -> a.workerId == offer.workerId && a.jobId == offer.jobId, plan.assignments)
let minutesFor (problem: AssignmentProblem, plan: CandidatePlan, workerId: WorkerId) =
    List.sum(List.map(o -> if o.workerId == workerId && selected(plan, o) then o.minutes.value else 0, problem.offers))
let positive (amount: Int) = if amount > 0 then amount else 0
let absolute (amount: Int) = if amount < 0 then 0 - amount else amount
let overtimeFor (problem: AssignmentProblem, plan: CandidatePlan, worker: Worker) =
    positive(minutesFor(problem, plan, worker.id) - worker.regularMinutes.value)

// hard: each job exactly once, qualifications, and maximum overtime.
// Collect every violation rather than stopping at the first one.
behavior evaluate : (input: EvaluationInput) -> Evaluation
let evaluate (input) = {
    let problem = input.problem
    let plan = input.plan
    let coverage = List.flatMap(j -> {
        let count = List.length(List.filter(a -> a.jobId == j.id, plan.assignments))
        if count == 1 then [] else [HardViolation { rule = "job_coverage", subject = j.id.value, actual = count, limit = 1, amount = absolute(count - 1) }]
    }, problem.jobs)
    let qualifications = List.flatMap(o ->
        if selected(plan, o) && Bool.not(o.qualified) then
            [HardViolation { rule = "qualification", subject = o.workerId.value ++ "/" ++ o.jobId.value, actual = 1, limit = 0, amount = 1 }]
        else [], problem.offers)
    let loads = List.map(w -> WorkerLoad { workerId = w.id, minutes = LoadMinutes(minutesFor(problem, plan, w.id)), overtime = LoadMinutes(overtimeFor(problem, plan, w)) }, problem.workers)
    let capacity = List.flatMap(w -> {
        let overtime = overtimeFor(problem, plan, w)
        if overtime <= w.overtimeLimit.value then [] else
            [HardViolation { rule = "overtime_limit", subject = w.id.value, actual = overtime, limit = w.overtimeLimit.value, amount = overtime - w.overtimeLimit.value }]
    }, problem.workers)
    let violations = coverage ++ qualifications ++ capacity
    // soft: overtime beyond the preferred target, weighted per excess minute.
    let penalties = List.flatMap(w -> {
        let overtime = overtimeFor(problem, plan, w)
        let excess = positive(overtime - w.overtimeTarget.value)
        if excess == 0 then [] else
            [SoftPenalty { rule = "overtime_target", subject = w.id.value, actual = overtime, limit = w.overtimeTarget.value, amount = excess, weight = w.overtimePenalty.value, penalty = excess * w.overtimePenalty.value }]
    }, problem.workers)
    let cost = List.sum(List.map(o -> if selected(plan, o) then o.cost.value else 0, problem.offers))
        + List.sum(List.map(w -> overtimeFor(problem, plan, w) * w.overtimeRate.value, problem.workers))
    let penalty = List.sum(List.map(p -> p.penalty, penalties))
    Evaluation { feasible = List.length(violations) == 0, hardViolations = violations, softPenalties = penalties, loads = loads, totalCost = TotalCost(cost), softPenalty = penalty, objectiveValue = cost + penalty }
}

// Adoption policy consumes the evaluation; it does not reimplement constraints.
behavior review : (input: EvaluationInput) -> PlanReview
let review (input) = {
    let evaluation = evaluate(input)
    let overtime = List.sum(List.map(l -> l.overtime.value, evaluation.loads))
    let decision = if Bool.not(evaluation.feasible) then Rejected
        else if overtime > 0 then RequiresApproval { overtimeMinutes = LoadMinutes(overtime) }
        else Ready
    PlanReview { plan = input.plan, evaluation = evaluation, decision = decision }
}
behavior confirm : (input: EvaluationInput, overtimeApproved: Bool) -> PlanReview
let confirm (input, overtimeApproved) = {
    let reviewed = review(input)
    let decision = match reviewed.decision with
        | Ready -> Confirmed
        | RequiresApproval { overtimeMinutes } ->
            if overtimeApproved then Confirmed else RequiresApproval { overtimeMinutes = overtimeMinutes }
        | Rejected -> Rejected
        | Confirmed -> Confirmed
    PlanReview { plan = reviewed.plan, evaluation = reviewed.evaluation, decision = decision }
}

example evaluate
    | "An empty plan is evaluable and feasible" :
        (EvaluationInput { problem = AssignmentProblem { workers = [], jobs = [], offers = [] }, plan = CandidatePlan { assignments = [] } })
        -> Evaluation { feasible = true, hardViolations = [], softPenalties = [], loads = [], totalCost = TotalCost(0), softPenalty = 0, objectiveValue = 0 }
    | "A missing assignment is a hard violation, not invalid data" :
        (EvaluationInput { problem = AssignmentProblem { workers = [], jobs = [Job { id = JobId("j") }], offers = [] }, plan = CandidatePlan { assignments = [] } })
        -> Evaluation { feasible = false, hardViolations = [HardViolation { rule = "job_coverage", subject = "j", actual = 0, limit = 1, amount = 1 }], softPenalties = [], loads = [], totalCost = TotalCost(0), softPenalty = 0, objectiveValue = 0 }
