// model/assignment.sou の日本語版。Rustの生成対象には含めない。

module 例.作業割当

// valid制約：値の表現、識別子、一意に解釈できる参照。
// 実行時の規模や数値の上限はRust側で検査し、ドメインのvalid制約とは分ける。
data 作業者番号 = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]*", value)
data 作業番号 = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]*", value)
data 分数 = Int
    invariant value >= 0
data 所要分数 = Int
    invariant value > 0
data 負荷分数 = Int
    invariant value >= 0
data 割当費用 = Int
    invariant value >= 0
data 分単価 = Int
    invariant value > 0
data 総費用 = Int
    invariant value >= 0

data 作業者 = { 番号: 作業者番号, 通常稼働分数: 分数, 残業上限分数: 分数, 残業分単価: 分単価, 残業目安分数: 分数, 残業超過分単価: 分単価 }
data 作業 = { 番号: 作業番号 }
// 担当不可でも所要時間と費用を定義する。
data 担当候補 = { 作業者番号: 作業者番号, 作業番号: 作業番号, 分数: 所要分数, 費用: 割当費用, 担当可能: Bool }
data 割当問題 = { 作業者一覧: List<作業者>, 作業一覧: List<作業>, 担当候補一覧: List<担当候補> }
    invariant 作業者番号の一意性 = List.all(作業者要素 -> List.length(List.filter(比較対象 -> 比較対象.番号 == 作業者要素.番号, 作業者一覧)) == 1, 作業者一覧)
    invariant 作業番号の一意性 = List.all(作業要素 -> List.length(List.filter(比較対象 -> 比較対象.番号 == 作業要素.番号, 作業一覧)) == 1, 作業一覧)
    invariant 担当候補の一意性 = List.all(候補要素 -> List.length(List.filter(比較候補 -> 比較候補.作業者番号 == 候補要素.作業者番号 && 比較候補.作業番号 == 候補要素.作業番号, 担当候補一覧)) == 1, 担当候補一覧)
    invariant 参照先の作業者が存在する = List.all(候補要素 -> List.any(作業者要素 -> 作業者要素.番号 == 候補要素.作業者番号, 作業者一覧), 担当候補一覧)
    invariant 参照先の作業が存在する = List.all(候補要素 -> List.any(作業要素 -> 作業要素.番号 == 候補要素.作業番号, 作業一覧), 担当候補一覧)

// 候補は選択した組合せの集合。作業の未割当や複数担当はhard違反として評価する。
// 負荷と費用は評価器で計算し、候補の入力項目には持たせない。
data 割当 = { 作業者番号: 作業者番号, 作業番号: 作業番号 }
data 候補計画 = { 割当一覧: List<割当> }
    invariant 割当組合せの一意性 = List.all(割当要素 -> List.length(List.filter(比較割当 -> 比較割当.作業者番号 == 割当要素.作業者番号 && 比較割当.作業番号 == 割当要素.作業番号, 割当一覧)) == 1, 割当一覧)
// 問題と候補を組にした評価対象の生成時に、参照に関するvalid制約を検査する。
data 評価対象 = { 問題: 割当問題, 計画: 候補計画 }
    invariant 組合せの定義が存在する = List.all(割当要素 -> List.any(候補要素 -> 候補要素.作業者番号 == 割当要素.作業者番号 && 候補要素.作業番号 == 割当要素.作業番号, 問題.担当候補一覧), 計画.割当一覧)

data 作業者負荷 = { 作業者番号: 作業者番号, 分数: 負荷分数, 残業分数: 負荷分数 }
data ハード制約違反 = { 規則: String, 対象: String, 実測値: Int, 許容値: Int, 違反量: Int }
data ソフト制約ペナルティ = { 規則: String, 対象: String, 実測値: Int, 許容値: Int, 違反量: Int, 重み: Int, ペナルティ: Int }
data 評価結果 = { 実行可能: Bool, ハード違反一覧: List<ハード制約違反>, ソフトペナルティ一覧: List<ソフト制約ペナルティ>, 負荷一覧: List<作業者負荷>, 総費用: 総費用, ソフトペナルティ合計: Int, 目的値: Int }

data 確定可能
data 承認待ち = { 残業合計分数: 負荷分数 }
data 却下
data 確定済み
data 採用判断 = 確定可能 | 承認待ち | 却下 | 確定済み
data 計画評価 = { 計画: 候補計画, 評価結果値: 評価結果, 採用判断値: 採用判断 }

// これらの型はソルバーの終了状態を表す。実行可能性は評価器が別途判定する。
data 最適終了候補 = { 計画: 候補計画 }
data 打切り候補 = { 計画: 候補計画, 終了理由: String }
data 実行不能
data 候補なし = { 終了理由: String }
data 求解結果 = 最適終了候補 | 打切り候補 | 実行不能 | 候補なし
behavior 求解する : (問題: 割当問題) -> 求解結果
    constructs 割当, 候補計画, 最適終了候補, 打切り候補, 候補なし

let 選択されているか (計画: 候補計画, 対象候補: 担当候補) =
    List.any(割当要素 -> 割当要素.作業者番号 == 対象候補.作業者番号 && 割当要素.作業番号 == 対象候補.作業番号, 計画.割当一覧)
let 作業分数を計算する (問題: 割当問題, 計画: 候補計画, 作業者番号: 作業者番号) =
    List.sum(List.map(候補要素 -> if 候補要素.作業者番号 == 作業者番号 && 選択されているか(計画, 候補要素) then 候補要素.分数.value else 0, 問題.担当候補一覧))
let 正の部分 (違反量: Int) = if 違反量 > 0 then 違反量 else 0
let 絶対値 (違反量: Int) = if 違反量 < 0 then 0 - 違反量 else 違反量
let 残業分数を計算する (問題: 割当問題, 計画: 候補計画, 対象作業者: 作業者) =
    正の部分(作業分数を計算する(問題, 計画, 対象作業者.番号) - 対象作業者.通常稼働分数.value)

// hard制約：各作業の一回割当、担当資格、残業上限。
// すべての違反を集めて返す。
behavior 評価する : (評価対象値: 評価対象) -> 評価結果
let 評価する (評価対象値) = {
    let 問題 = 評価対象値.問題
    let 計画 = 評価対象値.計画
    let 割当件数の違反 = List.flatMap(作業要素 -> {
        let 件数 = List.length(List.filter(割当要素 -> 割当要素.作業番号 == 作業要素.番号, 計画.割当一覧))
        if 件数 == 1 then [] else [ハード制約違反 { 規則 = "job_coverage", 対象 = 作業要素.番号.value, 実測値 = 件数, 許容値 = 1, 違反量 = 絶対値(件数 - 1) }]
    }, 問題.作業一覧)
    let 担当資格の違反 = List.flatMap(候補要素 ->
        if 選択されているか(計画, 候補要素) && Bool.not(候補要素.担当可能) then
            [ハード制約違反 { 規則 = "qualification", 対象 = 候補要素.作業者番号.value ++ "/" ++ 候補要素.作業番号.value, 実測値 = 1, 許容値 = 0, 違反量 = 1 }]
        else [], 問題.担当候補一覧)
    let 負荷一覧 = List.map(作業者要素 -> 作業者負荷 { 作業者番号 = 作業者要素.番号, 分数 = 負荷分数(作業分数を計算する(問題, 計画, 作業者要素.番号)), 残業分数 = 負荷分数(残業分数を計算する(問題, 計画, 作業者要素)) }, 問題.作業者一覧)
    let 残業上限の違反 = List.flatMap(作業者要素 -> {
        let 残業分数 = 残業分数を計算する(問題, 計画, 作業者要素)
        if 残業分数 <= 作業者要素.残業上限分数.value then [] else
            [ハード制約違反 { 規則 = "overtime_limit", 対象 = 作業者要素.番号.value, 実測値 = 残業分数, 許容値 = 作業者要素.残業上限分数.value, 違反量 = 残業分数 - 作業者要素.残業上限分数.value }]
    }, 問題.作業者一覧)
    let 違反一覧 = 割当件数の違反 ++ 担当資格の違反 ++ 残業上限の違反
    // soft制約：残業の目安を超えた分数に、分単価でペナルティを課す。
    let ペナルティ一覧 = List.flatMap(作業者要素 -> {
        let 残業分数 = 残業分数を計算する(問題, 計画, 作業者要素)
        let 超過量 = 正の部分(残業分数 - 作業者要素.残業目安分数.value)
        if 超過量 == 0 then [] else
            [ソフト制約ペナルティ { 規則 = "overtime_target", 対象 = 作業者要素.番号.value, 実測値 = 残業分数, 許容値 = 作業者要素.残業目安分数.value, 違反量 = 超過量, 重み = 作業者要素.残業超過分単価.value, ペナルティ = 超過量 * 作業者要素.残業超過分単価.value }]
    }, 問題.作業者一覧)
    let 費用 = List.sum(List.map(候補要素 -> if 選択されているか(計画, 候補要素) then 候補要素.費用.value else 0, 問題.担当候補一覧))
        + List.sum(List.map(作業者要素 -> 残業分数を計算する(問題, 計画, 作業者要素) * 作業者要素.残業分単価.value, 問題.作業者一覧))
    let ペナルティ = List.sum(List.map(比較候補 -> 比較候補.ペナルティ, ペナルティ一覧))
    評価結果 { 実行可能 = List.length(違反一覧) == 0, ハード違反一覧 = 違反一覧, ソフトペナルティ一覧 = ペナルティ一覧, 負荷一覧 = 負荷一覧, 総費用 = 総費用(費用), ソフトペナルティ合計 = ペナルティ, 目的値 = 費用 + ペナルティ }
}

// 採用判断は評価結果を使い、制約の検査を重複実装しない。
behavior 計画を評価する : (評価対象値: 評価対象) -> 計画評価
let 計画を評価する (評価対象値) = {
    let 評価結果値 = 評価する(評価対象値)
    let 残業分数 = List.sum(List.map(負荷要素 -> 負荷要素.残業分数.value, 評価結果値.負荷一覧))
    let 採用判断値 = if Bool.not(評価結果値.実行可能) then 却下
        else if 残業分数 > 0 then 承認待ち { 残業合計分数 = 負荷分数(残業分数) }
        else 確定可能
    計画評価 { 計画 = 評価対象値.計画, 評価結果値 = 評価結果値, 採用判断値 = 採用判断値 }
}
behavior 計画を確定する : (評価対象値: 評価対象, 残業承認済み: Bool) -> 計画評価
let 計画を確定する (評価対象値, 残業承認済み) = {
    let 評価済み計画 = 計画を評価する(評価対象値)
    let 採用判断値 = match 評価済み計画.採用判断値 with
        | 確定可能 -> 確定済み
        | 承認待ち { 残業合計分数 } ->
            if 残業承認済み then 確定済み else 承認待ち { 残業合計分数 = 残業合計分数 }
        | 却下 -> 却下
        | 確定済み -> 確定済み
    計画評価 { 計画 = 評価済み計画.計画, 評価結果値 = 評価済み計画.評価結果値, 採用判断値 = 採用判断値 }
}

example 評価する
    | "空の計画も評価でき、実行可能と判定する" :
        (評価対象 { 問題 = 割当問題 { 作業者一覧 = [], 作業一覧 = [], 担当候補一覧 = [] }, 計画 = 候補計画 { 割当一覧 = [] } })
        -> 評価結果 { 実行可能 = true, ハード違反一覧 = [], ソフトペナルティ一覧 = [], 負荷一覧 = [], 総費用 = 総費用(0), ソフトペナルティ合計 = 0, 目的値 = 0 }
    | "未割当はvalid違反として拒否せずhard違反として評価する" :
        (評価対象 { 問題 = 割当問題 { 作業者一覧 = [], 作業一覧 = [作業 { 番号 = 作業番号("j") }], 担当候補一覧 = [] }, 計画 = 候補計画 { 割当一覧 = [] } })
        -> 評価結果 { 実行可能 = false, ハード違反一覧 = [ハード制約違反 { 規則 = "job_coverage", 対象 = "j", 実測値 = 0, 許容値 = 1, 違反量 = 1 }], ソフトペナルティ一覧 = [], 負荷一覧 = [], 総費用 = 総費用(0), ソフトペナルティ合計 = 0, 目的値 = 0 }
