// model/assignment.sou の日本語版。Rustのビルド対象には含めない。
// キーワード、標準型、標準関数、value、理由コード、入力IDの形式は原版と共通。

module 例.作業割当

data 作業者番号 = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]{0,63}", value)
data 作業番号 = String
    invariant String.matches("[A-Za-z][A-Za-z0-9_-]{0,63}", value)
data 分数 = Int
    invariant value >= 0 && value <= 1440
data 所要分数 = Int
    invariant value > 0 && value <= 1440
data 負荷分数 = Int
    invariant value >= 0 && value <= 46080
data 割当費用 = Int
    invariant value >= 0 && value <= 1000000
data 分単価 = Int
    invariant value > 0 && value <= 10000
data 総費用 = Int
    invariant value >= 0 && value <= 1000000000

data 作業者 = { 番号: 作業者番号, 通常稼働分数: 分数, 残業上限分数: 分数, 残業分単価: 分単価 }
data 作業 = { 番号: 作業番号 }
// この一覧にある作業者と作業の組合せだけを担当可能とする。
data 担当候補 = { 作業者番号: 作業者番号, 作業番号: 作業番号, 分数: 所要分数, 費用: 割当費用 }
data 割当問題 = { 作業者一覧: List<作業者>, 作業一覧: List<作業>, 担当候補一覧: List<担当候補> }
    invariant 作業者数の上限 = List.length(作業者一覧) <= 16
    invariant 作業数の上限 = List.length(作業一覧) <= 32
    invariant 担当候補数の上限 = List.length(担当候補一覧) <= 512
    invariant 作業者番号の一意性 = List.all(作業者要素 -> List.length(List.filter(比較対象 -> 比較対象.番号 == 作業者要素.番号, 作業者一覧)) == 1, 作業者一覧)
    invariant 作業番号の一意性 = List.all(作業要素 -> List.length(List.filter(比較対象 -> 比較対象.番号 == 作業要素.番号, 作業一覧)) == 1, 作業一覧)
    invariant 担当候補の一意性 = List.all(候補要素 -> List.length(List.filter(比較候補 -> 比較候補.作業者番号 == 候補要素.作業者番号 && 比較候補.作業番号 == 候補要素.作業番号, 担当候補一覧)) == 1, 担当候補一覧)
    invariant 参照先の作業者が存在する = List.all(候補要素 -> List.any(作業者要素 -> 作業者要素.番号 == 候補要素.作業者番号, 作業者一覧), 担当候補一覧)
    invariant 参照先の作業が存在する = List.all(候補要素 -> List.any(作業要素 -> 作業要素.番号 == 候補要素.作業番号, 作業一覧), 担当候補一覧)

// 候補計画は現在の問題の条件に違反することがある。計画を検査する処理が却下理由を返す。
data 割当 = { 作業者番号: 作業者番号, 作業番号: 作業番号 }
data 作業者負荷 = { 作業者番号: 作業者番号, 分数: 負荷分数, 残業分数: 負荷分数 }
data 候補計画 = { 割当一覧: List<割当>, 負荷一覧: List<作業者負荷>, 総費用: 総費用 }
    invariant 割当数の上限 = List.length(割当一覧) <= 32
    invariant 負荷数の上限 = List.length(負荷一覧) <= 16

data 最適解あり = { 計画: 候補計画 }
data 実行可能解あり = { 計画: 候補計画, 終了理由: String }
data 実行不能
data 解未発見 = { 終了理由: String }
data 求解結果 = 最適解あり | 実行可能解あり | 実行不能 | 解未発見

data 確定可能
data 承認待ち = { 残業合計分数: 負荷分数 }
data 却下 = { 理由: String }
data 判定対象なし
data 計画判定 = 確定可能 | 承認待ち | 却下 | 判定対象なし
data 計画作成結果 = { 求解: 求解結果, 判定: 計画判定 }
data 確定済み = { 計画: 候補計画 }
data 確定結果 = 確定済み | 承認待ち | 却下

behavior 求解する : (問題: 割当問題) -> 求解結果
    constructs 割当, 作業者負荷, 候補計画, 最適解あり, 実行可能解あり, 解未発見

behavior 割当計画を作る : (問題: 割当問題) -> 計画作成結果
    depends on 求解する
let 割当計画を作る (問題, 求解する) = {
    let 結果 = 求解する(問題)
    let 判定 = match 結果 with
        | 最適解あり { 計画 } -> 計画を検査する(問題, 計画)
        | 実行可能解あり { 計画, 終了理由 } -> 計画を検査する(問題, 計画)
        | 実行不能 -> 判定対象なし
        | 解未発見 { 終了理由 } -> 判定対象なし
    計画作成結果 { 求解 = 結果, 判定 = 判定 }
}

behavior 計画を検査する : (問題: 割当問題, 計画: 候補計画) -> 計画判定
let 計画を検査する (問題, 計画) = {
    guard List.all(割当要素 -> List.length(List.filter(比較割当 -> 比較割当.作業番号 == 割当要素.作業番号, 計画.割当一覧)) == 1, 計画.割当一覧)
        && List.length(計画.割当一覧) == List.length(問題.作業一覧)
        && List.all(作業要素 -> List.any(割当要素 -> 割当要素.作業番号 == 作業要素.番号, 計画.割当一覧), 問題.作業一覧)
        else 却下 { 理由 = "job_coverage" }
    guard List.all(割当要素 -> List.any(候補要素 -> 候補要素.作業者番号 == 割当要素.作業者番号 && 候補要素.作業番号 == 割当要素.作業番号, 問題.担当候補一覧), 計画.割当一覧)
        else 却下 { 理由 = "qualification" }
    guard List.all(負荷要素 -> List.length(List.filter(比較負荷 -> 比較負荷.作業者番号 == 負荷要素.作業者番号, 計画.負荷一覧)) == 1, 計画.負荷一覧)
        && List.length(計画.負荷一覧) == List.length(問題.作業者一覧)
        && List.all(作業者要素 -> List.any(負荷要素 -> 負荷要素.作業者番号 == 作業者要素.番号, 計画.負荷一覧), 問題.作業者一覧)
        else 却下 { 理由 = "worker_coverage" }
    guard List.all(作業者要素 -> List.all(負荷要素 -> 負荷要素.作業者番号 /= 作業者要素.番号 ||
        (負荷要素.分数.value == 作業分数を計算する(問題, 計画, 作業者要素.番号)
         && 負荷要素.残業分数.value == 残業分数を計算する(問題, 計画, 作業者要素)
         && 負荷要素.残業分数.value <= 作業者要素.残業上限分数.value), 計画.負荷一覧), 問題.作業者一覧)
        else 却下 { 理由 = "workload" }
    guard 計画.総費用.value == 総費用を計算する(問題, 計画)
        else 却下 { 理由 = "total_cost" }
    let 残業分数 = List.sum(List.map(負荷要素 -> 負荷要素.残業分数.value, 計画.負荷一覧))
    if 残業分数 > 0 then 承認待ち { 残業合計分数 = 負荷分数(残業分数) }
    else 確定可能
}

// 残業承認は呼出し側が明示的に与える判断であり、ソルバーの終了状態とは別に扱う。
behavior 計画を確定する : (問題: 割当問題, 計画: 候補計画, 残業承認済み: Bool) -> 確定結果
let 計画を確定する (問題, 計画, 残業承認済み) =
    match 計画を検査する(問題, 計画) with
        | 確定可能 -> 確定済み { 計画 = 計画 }
        | 承認待ち { 残業合計分数 } ->
            if 残業承認済み then 確定済み { 計画 = 計画 }
            else 承認待ち { 残業合計分数 = 残業合計分数 }
        | 却下 { 理由 } -> 却下 { 理由 = 理由 }
        | 判定対象なし -> 却下 { 理由 = "unavailable" }

let 選択されているか (計画: 候補計画, 対象候補: 担当候補) =
    List.any(割当要素 -> 割当要素.作業者番号 == 対象候補.作業者番号 && 割当要素.作業番号 == 対象候補.作業番号, 計画.割当一覧)
let 作業分数を計算する (問題: 割当問題, 計画: 候補計画, 作業者番号: 作業者番号) =
    List.sum(List.map(候補要素 -> if 候補要素.作業者番号 == 作業者番号 && 選択されているか(計画, 候補要素) then 候補要素.分数.value else 0, 問題.担当候補一覧))
let 残業分数を計算する (問題: 割当問題, 計画: 候補計画, 対象作業者: 作業者) = {
    let 超過分数 = 作業分数を計算する(問題, 計画, 対象作業者.番号) - 対象作業者.通常稼働分数.value
    if 超過分数 > 0 then 超過分数 else 0
}
let 総費用を計算する (問題: 割当問題, 計画: 候補計画) =
    List.sum(List.map(候補要素 -> if 選択されているか(計画, 候補要素) then 候補要素.費用.value else 0, 問題.担当候補一覧))
    + List.sum(List.map(作業者要素 -> 残業分数を計算する(問題, 計画, 作業者要素) * 作業者要素.残業分単価.value, 問題.作業者一覧))

example 計画を検査する
    | "妥当な空の計画は確定できる" :
        (割当問題 { 作業者一覧 = [], 作業一覧 = [], 担当候補一覧 = [] },
         候補計画 { 割当一覧 = [], 負荷一覧 = [], 総費用 = 総費用(0) }) -> 確定可能
    | "候補計画の総費用が計算値と異なる場合は却下する" :
        (割当問題 { 作業者一覧 = [], 作業一覧 = [], 担当候補一覧 = [] },
         候補計画 { 割当一覧 = [], 負荷一覧 = [], 総費用 = 総費用(1) })
        -> 却下 { 理由 = "total_cost" }

example 計画を確定する
    | "承認済みでも不正な計画は確定できない" :
        (割当問題 { 作業者一覧 = [], 作業一覧 = [], 担当候補一覧 = [] },
         候補計画 { 割当一覧 = [], 負荷一覧 = [], 総費用 = 総費用(1) }, true)
        -> 却下 { 理由 = "total_cost" }
